# Public production URL used by metadata, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://devprodigee.com

# Hostinger SMTP settings used by the contact form.
# Create or use an existing Hostinger mailbox and add these values in your hosting environment.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@devprodigee.com
SMTP_PASSWORD=replace-with-the-mailbox-password

# The sender must normally be the same mailbox as SMTP_USER.
CONTACT_FROM_EMAIL=hello@devprodigee.com

# Comma-separated inboxes that receive every website enquiry.
CONTACT_TO_EMAILS=usman@devprodigee.com,yahya@devprodigee.com
