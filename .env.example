# Public production URL used by metadata, robots.txt and sitemap.xml

NEXT_PUBLIC_SITE_URL=https://ecommerce.devprodigee.com

# Add the verification tokens provided by each webmaster platform.

GOOGLE_SITE_VERIFICATION=replace-with-google-search-console-token
BING_SITE_VERIFICATION=replace-with-bing-webmaster-token

# Optional Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Hostinger SMTP settings used by the contact form.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@devprodigee.com
SMTP_PASSWORD=replace-with-your-smtp-password

# Sender email — should match SMTP_USER

CONTACT_FROM_EMAIL=info@devprodigee.com

# Inbox that receives website enquiries

CONTACT_TO_EMAILS=support@devprodigee.com
